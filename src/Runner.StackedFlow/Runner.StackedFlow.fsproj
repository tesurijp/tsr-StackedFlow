<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;NugetTest</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="tsr-StackedFlow"  Version="0.5"  Condition="'$(Configuration)' == 'NugetTest'" />
    <ProjectReference Include="..\StackedFlow\StackedFlow.fsproj"  Condition="'$(Configuration)' != 'NugetTest'" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
