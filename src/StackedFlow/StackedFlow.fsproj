<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Version>1.0</Version>

        <IsPackable>true</IsPackable>
        <Title>tsr-StackedFlow</Title>
        <PackageId>tsr-StackedFlow</PackageId>
        <Description>RPN like Stacked pipeline for F#</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/tesurijp/tsr-stackedflow</PackageProjectUrl>
        <RepositoryUrl>https://github.com/tesurijp/tsr-stackedflow</RepositoryUrl>
        <Authors>tesuri</Authors>
        <PackageTags>stack flow pipline rpn fsharp f#</PackageTags>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(SolutionDir)README.md" Pack="true" PackagePath="" Visible="False" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="StackType.fs" />
        <Compile Include="CallerContext.fs" />
        <Compile Include="StackControl.fs" />
        <Compile Include="FuncApplyer.fs" />
        <Compile Include="StackOperator.fs" />
    </ItemGroup>

</Project>
